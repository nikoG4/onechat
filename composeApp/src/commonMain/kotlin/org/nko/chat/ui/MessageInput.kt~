package org.nko.chat.ui

import androidx.compose.foundation.text.BasicTextField
import androidx.compose.runtime.Composable
import androidx.compose.runtime.mutableStateOf
import androidx.compose.ui.Modifier
import androidx.compose.foundation.layout.Row
import androidx.compose.material3.Button
import androidx.compose.material3.Text
import androidx.compose.runtime.getValue
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import org.nko.chat.models.MessageContent

@Composable
fun MessageInput(onSendMessage: (MessageContent) -> Unit) {
    var inputText = ""

    Row {
        BasicTextField(
            value = inputText,
            onValueChange = { inputText = it },
            modifier = Modifier.weight(1f)
        )
        Button(onClick = {
            if (inputText.isNotBlank()) {
                onSendMessage(MessageContent.Text(inputText))
                inputText = ""
            }
        }) {
            Text("Enviar")
        }
        Button(onClick = {
            onSendMessage(MessageContent.Image("https://via.placeholder.com/150"))
        }) {
            Text("📷")
        }

        Button(onClick = {
            onSendMessage(MessageContent.Audio("https://example.com/audio.mp3"))
        }) {
            Text("🎵")
        }

    }
}