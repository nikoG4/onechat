CREATE TABLE Contact (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT,
    email TEXT,
    phoneNumber TEXT,
    avatar TEXT,
    createdAt TEXT
);

CREATE TABLE Chat (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT,
    avatar TEXT,
    isGroup INTEGER AS Boolean DEFAULT 0,
    lastMessage TEXT,
    lastMessageAt TEXT,
    createdBy TEXT
);

CREATE TABLE Message (
    id TEXT NOT NULL PRIMARY KEY,
    chatId TEXT NOT NULL,
    senderId TEXT NOT NULL,
    text TEXT NOT NULL,
    status TEXT NOT NULL,
    type TEXT NOT NULL,
    media TEXT,
    createdAt TEXT NOT NULL,
    FOREIGN KEY (chatId) REFERENCES Chat(id) ON DELETE CASCADE
);

CREATE TABLE ChatParticipant (
    chatId TEXT NOT NULL,
    userId TEXT NOT NULL,
    PRIMARY KEY (chatId, userId),
    FOREIGN KEY (chatId) REFERENCES Chat(id) ON DELETE CASCADE,
    FOREIGN KEY (userId) REFERENCES Contact(id) ON DELETE CASCADE
);

-- Queries
insertContact:
INSERT OR REPLACE INTO Contact(id, name, email, phoneNumber, avatar, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

selectAllContacts:
SELECT * FROM Contact;

selectContactById:
SELECT * FROM Contact WHERE id = ?;

insertChat:
INSERT OR REPLACE INTO Chat(id, name, avatar, isGroup, lastMessage, lastMessageAt, createdBy)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllChats:
SELECT * FROM Chat ORDER BY lastMessageAt DESC;

insertMessage:
INSERT OR REPLACE INTO Message(id, chatId, senderId, text, status, type, media, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectMessagesForChat:
SELECT * FROM Message WHERE chatId = ? ORDER BY createdAt ASC;

insertParticipant:
INSERT OR REPLACE INTO ChatParticipant(chatId, userId)
VALUES (?, ?);

selectParticipantsForChat:
SELECT Contact.* FROM Contact
JOIN ChatParticipant ON Contact.id = ChatParticipant.userId
WHERE ChatParticipant.chatId = ?;
